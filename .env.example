# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_NAME=address_validation
DB_USER=postgres
DB_PASSWORD=postgres123

# ========================================
# APPLICATION CONFIGURATION
# ========================================
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ========================================
# VALIDATORS CONFIGURATION
# ========================================
# OpenStreetMap (FREE - Primary)
ENABLE_OSM_VALIDATOR=true
OSM_RATE_LIMIT=1

# ChatGPT Enhancement (PAID - Optional)
ENABLE_CHATGPT_ENHANCEMENT=false
OPENAI_API_KEY=

# USPS API (Future - Post Jan 2026)
ENABLE_USPS_API=false
USPS_API_KEY=

# Google Geocoding API (Optional - Paid)
ENABLE_GOOGLE_VALIDATOR=false
GOOGLE_API_KEY=

# ========================================
# PERFORMANCE SETTINGS
# ========================================
MAX_CONCURRENT_JOBS=5
CELERY_WORKERS=4
MAX_FILE_SIZE_MB=50

# ========================================
# CONFIDENCE THRESHOLDS
# ========================================
AUTO_APPROVE_THRESHOLD=90
MANUAL_REVIEW_THRESHOLD=70

# ========================================
# NOTIFICATIONS (Optional)
# ========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
